# Адрес сайта RAFTING_CFO и ключ для отправки туда состава сборной
# (спортсмены и тренеры — раздел «Сборная команда» на странице
# региональной федерации и разделы «Тренеры»/«Спортсмены» на странице
# клуба) — ключ должен совпадать со значением API_KEY в .env самого
# RAFTING_CFO.
RAFTING_CFO_URL=http://127.0.0.1:5003
RAFTING_CFO_API_KEY=change-me-to-a-random-api-key

# Резервное наименование субъекта РФ для отправки на RAFTING_CFO — с
# появлением переключателя субъектов в шапке (subjects.py) территория
# каждого спортсмена/тренера берётся из ЕГО СОБСТВЕННОГО субъекта
# (Athlete.subject, не внутренний район/город — Athlete.territory, он
# на сайте ЦФО не нужен); эта настройка используется только если у
# записи почему-то нет субъекта. Должно дословно совпадать с полем
# «Наименование субъекта РФ» соответствующей федерации в панели
# управления RAFTING_CFO (Регионы ЦФО → нужная федерация → Изменить).
RAFTING_CFO_REGION_SUBJECT_NAME=Московская область

# Ключ для входящих запросов (заголовок X-API-Key, см. routes/api.py) —
# COREZ ищет здесь спортсменов при заполнении предварительной заявки на
# соревнование (GET /api/athletes/search). Значение должно СОВПАДАТЬ со
# значением REGTEAM_RAFTING_API_KEY в .env самого COREZ.
API_KEY=change-me-to-a-random-api-key
